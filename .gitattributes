# Capture assets go through LFS. Images/ and Models/ predate this and remain
# plain blobs by decision (rewriting shared history is not worth the re-clone);
# these patterns keep future captures out of the repo's permanent weight.
*.mov filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text

# Small committed artifacts the app needs at runtime are NOT LFS.
data/figurines/exemplars/*.jpg -filter -diff -merge text=auto
data/cards/hashes.json -filter -diff -merge text=auto

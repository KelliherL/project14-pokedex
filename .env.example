# Copied to .env by install_windows.bat / install_linux.sh. Edit .env, not this.
# Read by docker compose and by the native backend (app/server.py).

# Host port the mongo container is published on. Change it if something else
# (e.g. another local mongo) already uses 27017.
MONGO_PORT=27017

# Where the native (Windows) backend finds mongo. Follows MONGO_PORT.
# The Linux backend container ignores this and uses mongodb://mongo:27017/.
MONGO_URL=mongodb://localhost:${MONGO_PORT}/

# Linux backend container only (start_linux.sh asks, these are the defaults):
# recognition mode (card | figurine) and the host webcam device.
MODE=card
CAMERA_DEVICE=/dev/video0
